// Modelo de dados do Reconcilia.
// Regras: dinheiro em centavos (Int), datas em UTC (timestamptz), garantias no banco.
// CHECKs não existem no schema do Prisma: ficam em SQL na migration (ver ADR 0002).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
  previewFeatures     = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  PENDING
  PAID
  CANCELED
}

enum PaymentEventType {
  AUTHORIZED
  CAPTURED
  REFUNDED
}

enum ErpEventType {
  PAYMENT_RECORDED
  REFUND_RECORDED
  ADJUSTMENT
}

enum LedgerAccount {
  GATEWAY_RECEIVABLE
  ORDER_REVENUE
  REFUNDS
  ERP_ADJUSTMENTS
}

enum LedgerDirection {
  DEBIT
  CREDIT
}

enum CaseType {
  PAYMENT_WITHOUT_ORDER
  DUPLICATE_WEBHOOK
  AMOUNT_MISMATCH
  CAPTURE_ON_CANCELED_ORDER
}

enum CaseStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum InvestigationStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
}

enum ActionKind {
  REPROCESS_WEBHOOK
  MARK_ORDER_PAID
  FLAG_ERP_DIVERGENCE
  IGNORE_DUPLICATE
  REFUND_CAPTURE
}

enum ActionStatus {
  PENDING
  APPROVED
  REJECTED
  EXECUTED
}

enum AuditEvent {
  APPROVED
  REJECTED
  EXECUTED
  EXECUTION_FAILED
}

/// Pedido da loja. CHECK: total_cents >= 0, installments >= 1.
model Order {
  id           String      @id @default(uuid(7)) @db.Uuid
  externalId   String      @unique @map("external_id")
  status       OrderStatus @default(PENDING)
  totalCents   Int         @map("total_cents")
  installments Int         @default(1)
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Quando a loja cancelou o pedido (order.canceled). Nulo enquanto não foi cancelado.
  canceledAt   DateTime?   @map("canceled_at") @db.Timestamptz(3)
  cases        Case[]

  @@map("orders")
}

/// Webhook bruto do gateway. event_id único é a garantia de idempotência da ingestão.
/// Sem FK para orders: o evento é gravado mesmo se o pedido ainda não existir.
/// CHECK: amount_cents >= 0, received_count >= 1.
model PaymentEvent {
  id              String           @id @default(uuid(7)) @db.Uuid
  provider        String
  eventId         String           @unique @map("event_id")
  orderExternalId String           @map("order_external_id")
  type            PaymentEventType
  amountCents     Int              @map("amount_cents")
  payload         Json
  receivedCount   Int              @default(1) @map("received_count")
  receivedAt      DateTime         @default(now()) @map("received_at") @db.Timestamptz(3)
  processedAt     DateTime?        @map("processed_at") @db.Timestamptz(3)

  @@index([orderExternalId])
  @@map("payment_events")
}

/// Evento bruto do ERP, com a mesma garantia de idempotência dos webhooks do gateway.
/// CHECK: amount_cents >= 0, received_count >= 1.
model ErpEvent {
  id              String       @id @default(uuid(7)) @db.Uuid
  eventId         String       @unique @map("event_id")
  orderExternalId String       @map("order_external_id")
  type            ErpEventType
  amountCents     Int          @map("amount_cents")
  payload         Json
  receivedCount   Int          @default(1) @map("received_count")
  receivedAt      DateTime     @default(now()) @map("received_at") @db.Timestamptz(3)

  @@index([orderExternalId])
  @@map("erp_events")
}

/// Cabeçalho de uma transação do ledger. transaction_id é a PK: postar duas vezes a mesma
/// transação é barrado pelo banco (derivado do eventId: "capture:<eventId>").
model LedgerTransaction {
  id          String        @id @map("transaction_id")
  description String
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  entries     LedgerEntry[]

  @@map("ledger_transactions")
}

/// Lançamento do ledger em partidas dobradas. CHECK: amount_cents > 0 (a direção dá o sinal).
/// Triggers (migration): soma zero por transaction_id no COMMIT e tabela append-only.
model LedgerEntry {
  id            String            @id @default(uuid(7)) @db.Uuid
  transactionId String            @map("transaction_id")
  transaction   LedgerTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  account       LedgerAccount
  direction     LedgerDirection
  amountCents   Int               @map("amount_cents")
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([transactionId])
  @@map("ledger_entries")
}

/// Divergência detectada pela conciliação. Só pode haver um caso OPEN por (pedido, tipo).
model Case {
  id             String          @id @default(uuid(7)) @db.Uuid
  orderId        String          @map("order_id") @db.Uuid
  order          Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  type           CaseType
  status         CaseStatus      @default(OPEN)
  detectedAt     DateTime        @default(now()) @map("detected_at") @db.Timestamptz(3)
  resolvedAt     DateTime?       @map("resolved_at") @db.Timestamptz(3)
  investigations Investigation[]
  auditEntries   AuditEntry[]

  @@unique([orderId, type], where: { status: "OPEN" }, map: "cases_one_open_per_order_type")
  @@index([orderId])
  @@index([status, type])
  @@map("cases")
}

/// Investigação do agente de IA. CHECK: confidence nulo ou entre 0 e 1.
model Investigation {
  id              String              @id @default(uuid(7)) @db.Uuid
  caseId          String              @map("case_id") @db.Uuid
  case            Case                @relation(fields: [caseId], references: [id], onDelete: Restrict)
  status          InvestigationStatus @default(QUEUED)
  steps           Json                @default("[]")
  diagnosis       String?
  /// Evidências citadas pelo agente (strings que apontam dados concretos das ferramentas).
  evidence        Json                @default("[]")
  suggestedAction Json?               @map("suggested_action")
  confidence      Float?
  failureReason   String?             @map("failure_reason")
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  actions         Action[]

  /// No máximo uma investigação ativa (QUEUED ou RUNNING) por caso. O predicado está na forma
  /// que o Postgres normaliza o IN (...), para o Prisma não ver drift.
  @@unique([caseId], where: raw("status = ANY (ARRAY['QUEUED'::\"InvestigationStatus\", 'RUNNING'::\"InvestigationStatus\"])"), map: "investigations_one_active_per_case")
  @@index([caseId])
  @@map("investigations")
}

/// Ação sugerida pelo agente. Só é executada pelo backend após aprovação humana.
model Action {
  id              String        @id @default(uuid(7)) @db.Uuid
  investigationId String        @map("investigation_id") @db.Uuid
  investigation   Investigation @relation(fields: [investigationId], references: [id], onDelete: Restrict)
  kind            ActionKind
  params          Json
  status          ActionStatus  @default(PENDING)
  decidedAt       DateTime?     @map("decided_at") @db.Timestamptz(3)
  /// Quem aprovou ou recusou: o operador do token de sessão (POST /session), não o corpo.
  decidedBy       String?       @map("decided_by")
  rejectionReason String?       @map("rejection_reason")
  /// O que a execução fez (ou já encontrou feito).
  executionResult Json?         @map("execution_result")
  executedAt      DateTime?     @map("executed_at") @db.Timestamptz(3)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  auditEntries    AuditEntry[]

  @@index([investigationId])
  @@map("actions")
}

/// Trilha de auditoria das decisões humanas e das execuções. Append-only (trigger na migration).
model AuditEntry {
  id       String     @id @default(uuid(7)) @db.Uuid
  actionId String     @map("action_id") @db.Uuid
  action   Action     @relation(fields: [actionId], references: [id], onDelete: Restrict)
  caseId   String     @map("case_id") @db.Uuid
  case     Case       @relation(fields: [caseId], references: [id], onDelete: Restrict)
  event    AuditEvent
  actor    String
  details  Json       @default("{}")
  at       DateTime   @default(now()) @db.Timestamptz(3)

  @@index([caseId])
  @@index([actionId])
  @@map("audit_log")
}

/// Caixa de entrada do ERP SIMULADO: pedidos de ajuste enviados pelo Reconcilia (sistema externo).
/// action_id único: aprovar de novo não manda o ajuste duas vezes. CHECK: valores >= 0.
model SimErpAdjustment {
  id              String   @id @default(uuid(7)) @db.Uuid
  actionId        String   @unique @map("action_id") @db.Uuid
  orderExternalId String   @map("order_external_id")
  expectedCents   Int      @map("expected_cents")
  erpCents        Int      @map("erp_cents")
  /// erp_cents - expected_cents (com sinal: positivo = o ERP registrou a mais).
  differenceCents Int      @map("difference_cents")
  requestedAt     DateTime @default(now()) @map("requested_at") @db.Timestamptz(3)

  @@index([orderExternalId])
  @@map("sim_erp_adjustments")
}

/// Extrato do gateway SIMULADO: representa um sistema externo, não dados do Reconcilia.
/// Num gateway real viria da API de conciliação dele. charge_id único torna o reenvio idempotente.
/// CHECK: amount_cents >= 0.
model SimGatewayStatementEntry {
  id              String   @id @default(uuid(7)) @db.Uuid
  chargeId        String   @unique @map("charge_id")
  eventId         String   @map("event_id")
  orderExternalId String   @map("order_external_id")
  amountCents     Int      @map("amount_cents")
  capturedAt      DateTime @map("captured_at") @db.Timestamptz(3)

  @@index([orderExternalId])
  @@map("sim_gateway_statement")
}
