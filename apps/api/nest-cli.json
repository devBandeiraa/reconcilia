{
  "$schema": "https://json.schemastore.org/nest-cli",
  "sourceRoot": "src",
  "entryFile": "main",
  "compilerOptions": {
    "builder": "tsc",
    "tsConfigPath": "tsconfig.build.json",
    "deleteOutDir": true,
    "assets": [
      {
        "include": "agent/prompts/*.md"
      },
      {
        "include": "agent/fixtures/*.json"
      }
    ],
    "watchAssets": true
  }
}
