# Copie para apps/api/.env. Todas têm padrão para desenvolvimento local.
NODE_ENV=development
PORT=3001
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Banco. Localmente as duas apontam para o Postgres do docker-compose (porta 5440).
# Na Neon: DATABASE_URL é a URL do pooler (usada pelo app) e DIRECT_URL a conexão
# direta (usada pela CLI do Prisma nas migrations).
DATABASE_URL=postgresql://reconcilia:reconcilia@localhost:5440/reconcilia
DIRECT_URL=postgresql://reconcilia:reconcilia@localhost:5440/reconcilia

# Segredo do HMAC dos webhooks (header X-Signature). O padrão serve só para desenvolvimento;
# em produção a api não sobe sem um segredo próprio com 32+ caracteres.
# WEBHOOK_SECRET=

# Fila (pg-boss, no próprio Postgres). Tentativas extras antes da dead letter queue, atraso base
# do retry (cresce em backoff exponencial, teto de 300s) e intervalo de polling do worker.
QUEUE_RETRY_LIMIT=5
QUEUE_RETRY_DELAY_SECONDS=2
QUEUE_POLLING_SECONDS=2

# Conciliação agendada (cron de 5 campos, em UTC). `off` desliga o agendamento nesta instância.
RECONCILIATION_CRON=*/5 * * * *

# Agente de IA. DEMO_REPLAY=true (padrão) segue roteiros gravados, sem chamar o Gemini e sem custo.
# Para usar o Gemini: DEMO_REPLAY=false e a chave gratuita do Google AI Studio (não exige cartão).
DEMO_REPLAY=true
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Fuso da loja: só para exibir horários locais ao agente e na interface; o banco é sempre UTC.
STORE_TIMEZONE=America/Sao_Paulo
