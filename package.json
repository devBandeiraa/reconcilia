{
  "name": "reconcilia",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Detecta pagamentos que não batem entre loja, gateway e ERP; um agente de IA investiga e uma pessoa aprova.",
  "license": "MIT",
  "author": "Jhordan Bandeira",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "scripts": {
    "codegen": "pnpm --filter @reconcilia/shared build && pnpm --filter @reconcilia/simulator build && pnpm --filter @reconcilia/api db:generate",
    "dev": "pnpm codegen && pnpm --parallel --filter @reconcilia/shared --filter @reconcilia/simulator --filter @reconcilia/api --filter @reconcilia/web run dev",
    "build": "pnpm codegen && pnpm -r run build",
    "lint": "pnpm codegen && eslint .",
    "typecheck": "pnpm codegen && pnpm -r run typecheck",
    "test": "pnpm codegen && pnpm -r run test",
    "db:reset": "pnpm --filter @reconcilia/api db:reset",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky && pnpm codegen"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": "prettier --write"
  }
}
